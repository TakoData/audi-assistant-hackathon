# The Android emulator reaches your Mac at 10.0.2.2. Use your Mac's LAN IP on a physical device.
EXPO_PUBLIC_TAKO_PROXY_URL=http://10.0.2.2:8787
# A revocable demo token, not the Tako API key. Use a long random value.
EXPO_PUBLIC_DEMO_ACCESS_TOKEN=replace_with_demo_token

# Server-only values. Never expose this key through EXPO_PUBLIC_*.
TAKO_API_KEY=replace_me
TAKO_API_URL=https://tako.com/api/v1/answer
DEMO_ACCESS_TOKEN=replace_with_the_same_demo_token
DEMO_RATE_LIMIT_PER_HOUR=60
PORT=8787

# Lets the proxy return a representative response without calling Tako.
DEMO_MODE=false
